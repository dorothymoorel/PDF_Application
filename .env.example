# TransLoka is local-only by default. Keep API, web, and Ollama access on this machine.
# Copy this file to .env for local development and never commit the real .env.

# Safe relative development path; the final Windows default remains an open architecture decision.
TRANSLOKA_DATA_DIR=./transloka-data

# Local API binding only. Do not change this to a public bind address.
TRANSLOKA_API_HOST=127.0.0.1
TRANSLOKA_API_PORT=8000

# Browser origins permitted to access the local API.
TRANSLOKA_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Local Ollama service only; remote model endpoints are not supported by default.
TRANSLOKA_OLLAMA_URL=http://127.0.0.1:11434

TRANSLOKA_LOG_LEVEL=INFO
TRANSLOKA_DEBUG=false
